# Copy this file to .env (npm run setup does it for you if .env is missing)

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=library
POSTGRES_PASSWORD=library123
POSTGRES_DB=smartlibrary
POSTGRES_PORT=5433
DATABASE_URL=postgresql://library:library123@localhost:5433/smartlibrary

# Signs login cookies. npm run setup generates a random one if this is CHANGE_ME
JWT_SECRET=CHANGE_ME
COOKIE_SECURE=false

# OPTIONAL: lets the AI assistant phrase its answers with Claude.
# Leave empty to use the built-in (offline) assistant - everything still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
